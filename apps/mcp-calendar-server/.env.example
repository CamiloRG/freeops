# ─────────────────────────────────────────────────────────────────────────────
# apps/mcp-calendar-server — FreeOps calendar MCP server
#
# Copy to `.env.local` (gitignored) for local development. On Fly.io /
# Railway these are set as service secrets, not as a file.
#
# Every value here is a FreeOps-owned PLATFORM secret. No per-user secret
# ever belongs in this file: per-freelancer OAuth tokens live encrypted in
# `calendar_connections`, keyed by (user_id, provider).
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port. Fly.io/Railway inject this; 8787 is the local default.
# Health check path is GET /healthz; the MCP endpoint is POST /mcp.
PORT=8787

# ── Google Calendar OAuth client ─────────────────────────────────────────────
# Reuses the SAME Google Cloud OAuth client as Supabase login — it just
# needs the Calendar scopes enabled and this app's calendar-callback
# redirect URI added in the Google Cloud console.
#
# Scopes the Stage-2 authorization URL must request:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.freebusy
#   openid email                    (so the exchange returns an id_token we
#                                    can read provider_account_email from)
# plus access_type=offline & prompt=consent, without which Google issues no
# refresh token and the connection dies after one hour.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Microsoft Graph OAuth client ─────────────────────────────────────────────
# Reuses the SAME Entra App Registration as Supabase login, registered
# multi-tenant, so this service talks to the `common` endpoint and needs no
# tenant id.
#
# Scopes the Stage-2 authorization URL must request:
#   offline_access                  (without it: no refresh token)
#   User.Read                       (GET /me → provider_account_email)
#   https://graph.microsoft.com/Calendars.ReadWrite
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase transaction-mode pooler (port 6543) — the same value apps/web
# uses. This service only reads/writes the already-migrated schema through
# @freeops/db; it never runs migrations, so DIRECT_URL is deliberately NOT
# required here (that is drizzle-kit's, and therefore packages/db's, concern).
DATABASE_URL=

# ── Field encryption ─────────────────────────────────────────────────────────
# 32 random bytes, base64. MUST be byte-identical to apps/web's value:
# both services encrypt/decrypt the same `*_encrypted bytea` columns through
# the shared @freeops/db/encryption module, so a mismatch makes rows written
# by one undecryptable by the other.
ENCRYPTION_KEY=
