# Copy to .env.local (gitignored) and fill in real values.
# See app_spec.md's "Environment Variable Reference" for the full picture —
# only the variables actually used by code so far are listed here; more get
# added as each phase needs them.

# --- Phase 1 (now) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2 (Postgres / Drizzle) ---
# DATABASE_URL = Supabase transaction pooler, port 6543 (app runtime, used by packages/db's client)
# DIRECT_URL   = Supabase direct connection, port 5432 (drizzle-kit migrations only)
# Percent-encode any special characters (%, =, etc.) in the password.
DATABASE_URL=
DIRECT_URL=

# --- Phase 3 (Supabase Auth) ---
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = client-safe,
#   used by the browser client, server client, and proxy (src/proxy.ts).
# SUPABASE_SECRET_KEY = server-only, bypasses RLS — used only for privileged
#   admin operations (src/lib/supabase/admin.ts). Never expose to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Google/Microsoft OAuth sign-in is a later phase (deferred on purpose —
# see the sign-in/sign-up pages' disabled "Coming soon" buttons); these
# stay commented out until that phase wires them up.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# --- Phase 4 (Cloudflare R2 — file storage, profile/branding/tax uploads) ---
# Use an Account API token (not a User token) scoped Object Read & Write —
# account tokens survive teammate/user changes, user tokens don't.
# R2_ENDPOINT = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Buckets — private by default, access only via short-lived signed URLs,
# never public bucket ACLs (see app_spec.md's "File storage" section).
R2_BUCKET_BRANDING_LOGOS=branding-logos
R2_BUCKET_CONTRACT_DOCUMENTS=contract-documents
R2_BUCKET_TAX_DOCUMENTS=tax-documents
R2_BUCKET_WITHHOLDING_CERTIFICATES=withholding-certificates
R2_BUCKET_VAULT_EXPORTS=vault-exports
R2_BUCKET_RESUME_EXPORTS=resume-exports
