{
  "name": "@freeops/rules-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Config-driven compliance rules engine (PILA/DIAN, LATAM-ready) for FreeOps — no regulatory formula is ever hardcoded in application code; every rule is versioned config data resolved point-in-time.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./pila": "./src/pila.ts",
    "./resolver": "./src/resolver.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed-config.ts"
  },
  "dependencies": {
    "@freeops/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.22.0"
}
