# Optional local override, gitignored (copy to .env.local in this folder).
#
# By default, drizzle-kit and `pnpm db:migrate` resolve DATABASE_URL /
# DIRECT_URL from apps/web/.env.local (the real Supabase project) — you
# don't need this file for that.
#
# Create packages/db/.env.local from this file only when you want to point
# the Drizzle CLI at the local docker-compose Postgres instead (`docker
# compose up -d postgres` from the repo root), e.g. to iterate on schema
# changes without touching the shared Supabase dev database. Values below
# match docker-compose.yml's `postgres` service exactly.
#
# Local docker Postgres has no pooler, so DATABASE_URL and DIRECT_URL are
# the same connection string.
DATABASE_URL=postgresql://freeops:freeops_local_dev@localhost:54329/freeops
DIRECT_URL=postgresql://freeops:freeops_local_dev@localhost:54329/freeops
