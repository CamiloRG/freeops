{
  "name": "freeops",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @freeops/db db:generate",
    "db:migrate": "pnpm --filter @freeops/db db:migrate",
    "db:push": "pnpm --filter @freeops/db db:push",
    "db:studio": "pnpm --filter @freeops/db db:studio",
    "db:check": "pnpm --filter @freeops/db db:check"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
